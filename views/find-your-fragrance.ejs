<!-- find-your-fragrance.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Find Your Fragrance</title>
    <link rel="stylesheet" href="/css/find-your-fragrance.css">
</head>
<body>
    <header>
        <div class="logo">KiwiScents</div>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/products">Fragrances</a></li>
                <li><a href="/about">About Us</a></li>
                <li><a href="/cart">Your Cart</a></li>
            </ul>
        </nav>
    </header>

    <div class="container">
        <h2>Find Your Perfect Fragrance</h2>

        <form action="/find-fragrance" method="POST">
            <label for="gender">Gender:</label>
            <select id="gender" name="gender" required>
                <option value="">Select</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Unisex">Unisex</option>
            </select>

            <label for="scent_type">What scent do you prefer?</label>
            <select id="scent_type" name="scent_type" required>
                <option value="">Select</option>
                <option value="Any">Any</option>
                <option value="Floral">Floral</option>
                <option value="Woody">Woody</option>
                <option value="Citrus">Citrus</option>
                <option value="Spicy">Spicy</option>
                <option value="Fresh">Fresh</option>
            </select>

            <label for="budget">Budget (in $):</label>
            <input type="number" id="budget" name="budget" required>

            <button type="submit">Find My Fragrance</button>
        </form>
    </div>
</body>
</html>