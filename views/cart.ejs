<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Cart | KiwiScents</title>
    <link rel="stylesheet" href="/css/cart.css">
</head>
<body>
    <header>
        <div class="logo">KiwiScents</div>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/products">Fragrances</a></li>
                <li><a href="/about">About Us</a></li>
                <li><a href="/cart">Your Cart</a></li>
            </ul>
        </nav>
    </header>

    <div class="container">
        <h2>Your Shopping Cart</h2>
        
        <div id="cart-items-container">
            <!-- Cart items will be dynamically inserted here -->
        </div>
        
        <div class="cart-actions">
            <a href="/products" class="btn">Continue Shopping</a>
            <button id="checkout-btn" class="btn">Proceed to Checkout</button>
        </div>

        <!-- Payment Form (Hidden by default) -->
        <div id="payment-form-container" style="display:none;">
            <h3>Checkout</h3>
            <form id="payment-form">
                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="name" required>
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required>
                </div>
                <div class="form-group">
                    <label for="address">Shipping Address</label>
                    <textarea id="address" name="address" required></textarea>
                </div>
                
                <h4>Payment Method</h4>
                <div class="payment-options">
                    <div class="payment-option">
                        <input type="radio" id="payment-credit" name="payment-method" value="credit" checked>
                        <label for="payment-credit">Credit/Debit Card</label>
                        
                        <div class="credit-card-details">
                            <div class="form-group">
                                <label for="card-name">Name on Card</label>
                                <input type="text" id="card-name" name="card-name" placeholder="Full Name" required>
                            </div>
                            <div class="form-group">
                                <label for="card-number">Card Number</label>
                                <input type="text" id="card-number" name="card-number" placeholder="1234 5678 9012 3456" required>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="expiry">Expiry (MM/YY)</label>
                                    <input type="text" id="expiry" name="expiry" placeholder="MM/YY" required>
                                </div>
                                <div class="form-group">
                                    <label for="cvc">CVC</label>
                                    <input type="text" id="cvc" name="cvc" placeholder="123" required>
                                </div>
                            </div>
                        </div>
                        
                    
            
                    
                    <div class="payment-option">
                        <input type="radio" id="payment-bank" name="payment-method" value="bank">
                        <label for="payment-bank">Direct Bank Transfer</label>
                    </div>
                </div>
                
                <div id="bank-details" style="display:none;">
                    <h4>Bank Transfer Details</h4>
                    <p>Please transfer the total amount to the following bank account:</p>
                    <p><strong>Bank Name:</strong> ASBk</p>
                    <p><strong>Account Name:</strong> M J HEARD</p>
                    <p><strong>Account Number:</strong> 12-3290-0064638-50</p>
                    <p><strong>Put Reference as:</strong> Cologne</p>
                    
                </div>
                
                <div class="form-group">
                    <button type="submit" id="place-order-btn" class="btn">Place Order</button>
                </div>
            </form>
        </div>
        
        <!-- Order Confirmation (Hidden by default) -->
        <div id="order-confirmation" style="display:none;">
            <h3>Thank You for Your Order!</h3>
            <p>Your order has been placed successfully.</p>
            <p>Order Reference: <span id="confirmation-reference">KS-12345</span></p>
            <p>We will send you an email confirmation shortly.</p>
            <a href="/products" class="btn">Continue Shopping</a>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Get cart items from localStorage
            let cartItems = JSON.parse(localStorage.getItem('cartItems')) || [];
            const cartContainer = document.getElementById('cart-items-container');
            const checkoutBtn = document.getElementById('checkout-btn');
            const paymentForm = document.getElementById('payment-form-container');
            const orderConfirmation = document.getElementById('order-confirmation');
            let orderTotal = 0;
            
            // Function to render the cart
            function renderCart() {
                if (cartItems.length === 0) {
                    cartContainer.innerHTML = '<p>Your cart is currently empty.</p>';
                    checkoutBtn.disabled = true;
                } else {
                    checkoutBtn.disabled = false;
                    
                    let cartHTML = `
                        <table border="1" width="100%">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Description</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Subtotal</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                    `;
                    
                    let total = 0;
                    
                    cartItems.forEach(item => {
                        const subtotal = item.price * item.quantity;
                        total += subtotal;
                        
                        cartHTML += `
                            <tr data-id="${item.id}">
                                <td>${item.category}</td>
                                <td>${item.description}</td>
                                <td>$${item.price.toFixed(2)}</td>
                                <td>
                                    <button class="decrease-qty" data-id="${item.id}">-</button>
                                    <span>${item.quantity}</span>
                                    <button class="increase-qty" data-id="${item.id}">+</button>
                                </td>
                                <td>$${subtotal.toFixed(2)}</td>
                                <td>
                                    <button class="remove-item" data-id="${item.id}">Remove</button>
                                </td>
                            </tr>
                        `;
                    });
                    
                    cartHTML += `
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" align="right"><strong>Total:</strong></td>
                                    <td>$${total.toFixed(2)}</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    `;
                    
                    cartContainer.innerHTML = cartHTML;
                    orderTotal = total;
                    
                    // Generate a unique order reference
                    const orderRef = 'KS-' + Math.floor(100000 + Math.random() * 900000);
                    document.getElementById('order-reference').textContent = orderRef;
                    document.getElementById('confirmation-reference').textContent = orderRef;
                    
                    // Add event listeners for the quantity buttons
                    document.querySelectorAll('.decrease-qty').forEach(button => {
                        button.addEventListener('click', function() {
                            const id = this.getAttribute('data-id');
                            updateQuantity(id, -1);
                        });
                    });
                    
                    document.querySelectorAll('.increase-qty').forEach(button => {
                        button.addEventListener('click', function() {
                            const id = this.getAttribute('data-id');
                            updateQuantity(id, 1);
                        });
                    });
                    
                    document.querySelectorAll('.remove-item').forEach(button => {
                        button.addEventListener('click', function() {
                            const id = this.getAttribute('data-id');
                            removeItem(id);
                        });
                    });
                }
            }
            
            // Function to update quantity
            function updateQuantity(id, change) {
                const itemIndex = cartItems.findIndex(item => item.id == id);
                if (itemIndex !== -1) {
                    cartItems[itemIndex].quantity += change;
                    
                    // Remove item if quantity is 0 or less
                    if (cartItems[itemIndex].quantity <= 0) {
                        cartItems.splice(itemIndex, 1);
                    }
                    
                    // Save to localStorage and re-render
                    localStorage.setItem('cartItems', JSON.stringify(cartItems));
                    renderCart();
                }
            }
            
            // Function to remove item
            function removeItem(id) {
                cartItems = cartItems.filter(item => item.id != id);
                localStorage.setItem('cartItems', JSON.stringify(cartItems));
                renderCart();
            }
            
            // Initial render
            renderCart();
            
            // Checkout button event
            checkoutBtn.addEventListener('click', function() {
                if (cartItems.length > 0) {
                    cartContainer.style.display = 'none';
                    document.querySelector('.cart-actions').style.display = 'none';
                    paymentForm.style.display = 'block';
                }
            });
            
            // Payment method selection
            document.querySelectorAll('input[name="payment-method"]').forEach(radio => {
                radio.addEventListener('change', function() {
                    const bankDetails = document.getElementById('bank-details');
                    if (this.value === 'bank') {
                        bankDetails.style.display = 'block';
                    } else {
                        bankDetails.style.display = 'none';
                    }
                });
            });
            
            // Submit payment form
            document.getElementById('payment-form').addEventListener('submit', function(e) {
                e.preventDefault();
                
                // Get payment method
                const paymentMethod = document.querySelector('input[name="payment-method"]:checked').value;
                
                // Here you would typically make an AJAX call to your server to process payment
                // For this example, we'll just simulate a successful payment
                
                if (paymentMethod === 'bank') {
                    // For bank transfers, just show the confirmation
                    paymentForm.style.display = 'none';
                    orderConfirmation.style.display = 'block';
                } else {
                    // For other payment methods, simulate processing
                    const placeOrderBtn = document.getElementById('place-order-btn');
                    placeOrderBtn.disabled = true;
                    placeOrderBtn.textContent = 'Processing...';
                    
                    // Simulate payment processing with a delay
                    setTimeout(function() {
                        paymentForm.style.display = 'none';
                        orderConfirmation.style.display = 'block';
                        
                        // Clear cart after successful purchase
                        localStorage.removeItem('cartItems');
                        cartItems = [];
                    }, 2000);
                }
            });
        });
    </script>
</body>
</html>